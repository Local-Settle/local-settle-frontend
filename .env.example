# ------------------------------------------------------------------
# LocalSettle frontend environment variables
# Copy this file to `.env.local` (or set the values in your shell/CI) and
# adjust to match your local backend.
# ------------------------------------------------------------------

# Base URL of the LocalSettle API
NEXT_PUBLIC_API_URL=http://localhost:3000

# Trustless Work API (escrow on Stellar)
NEXT_PUBLIC_TRUSTLESS_WORK_API_URL=
NEXT_PUBLIC_TRUSTLESS_WORK_API_KEY=

# Stellar configuration
NEXT_PUBLIC_USDC_ISSUER=
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# ------------------------------------------------------------------
# Demo mode (IKSH-46)
#
# Set to `true` ONLY for design validation. When off (default), the `/demo`
# and `mock-*` order routes never render fabricated data, and the demo-only
# fixtures are tree-shaken out of the production bundle.
# ------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=false
